# ---------------------------------------------------------------------------
# deskswarm configuration
# Copy this file to .env and fill in the values before `docker compose up`.
#
# The fleet itself is NOT configured here — you add and remove computers from
# the dashboard UI at runtime, and they're stored in the database.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Model configuration
#
# deskswarm uses the cua Agent SDK (https://github.com/trycua/cua), which is
# built on LiteLLM — so DESKSWARM_MODEL accepts any LiteLLM model string.
# Pick ONE of the setups below.
# ---------------------------------------------------------------------------

# --- Option A: Anthropic API directly (recommended, most reliable) ---------
# Get a key at https://console.anthropic.com — this is a real billed API
# key, NOT a claude.ai / Claude Pro subscription login.
# DESKSWARM_MODEL=anthropic/claude-haiku-4-5-20251001
# DESKSWARM_API_KEY=sk-ant-...
# DESKSWARM_API_BASE=

# --- Option B: OpenAI API directly ------------------------------------------
# DESKSWARM_MODEL=openai/gpt-4o
# DESKSWARM_API_KEY=sk-...
# DESKSWARM_API_BASE=

# --- Option C: any OpenAI-compatible proxy ----------------------------------
# Works with LiteLLM proxy, an internal gateway, or similar. Use a model name
# containing "claude-" to route through cua's Anthropic-style tool loop,
# which is the best-tested path.
# DESKSWARM_MODEL=anthropic/claude-sonnet-4-6
# DESKSWARM_API_BASE=http://your-proxy-host:port
# DESKSWARM_API_KEY=your-proxy-api-key

# --- Option D: local Ollama ---------------------------------------------------
# Experimental — see README "Local models". Needs extra deps (torch,
# qwen-agent) baked into a custom dashboard image; not included by default
# because of image size. Vision + tool-calling capable models only.
# DESKSWARM_MODEL=ollama_chat/qwen3.5:9b
# DESKSWARM_API_BASE=http://your-ollama-host:11434
# DESKSWARM_API_KEY=

DESKSWARM_MODEL=anthropic/claude-haiku-4-5-20251001
DESKSWARM_API_KEY=
DESKSWARM_API_BASE=

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# If set, every mutating endpoint (create/delete/rename a computer, run a
# command, dispatch a task) requires "Authorization: Bearer <token>".
# Leave empty for local/trusted-network use only.
DASHBOARD_TOKEN=

DASHBOARD_PORT=7861

# Rows per page in the task log.
DESKSWARM_PAGE_SIZE=25
# Ceiling on how many machines one "agent-{1..N}" batch may create.
DESKSWARM_MAX_BULK_CREATE=25
# Seconds before a task is killed and marked failed.
DESKSWARM_TASK_TIMEOUT=300
# How many tasks may run at once. A fleet-wide dispatch queues behind this
# instead of starting every machine's agent simultaneously.
DESKSWARM_MAX_CONCURRENT_TASKS=8

# ---------------------------------------------------------------------------
# Guards
#
# deskswarm already recovers from process failures. These catch the quiet
# ones: a schedule burning money, memory running out a machine at a time, a
# disk filling with snapshots, or every task failing because the provider is
# down.
# ---------------------------------------------------------------------------

# Stop dispatching once this much has been spent today (UTC). 0 disables it.
# A schedule every minute across 7 machines is ~10,000 tasks a day, so this is
# the difference between a bad afternoon and a bad invoice.
DESKSWARM_DAILY_COST_LIMIT=0

# Refuse to create a machine that would leave less than this free. A machine
# is two containers: measured idle, the desktop takes 200-235 MB and the
# bridge 145-190 MB, so ~400 MB each before doing any work. A machine running
# a browser goes past 600 MB.
DESKSWARM_MACHINE_MB=400
DESKSWARM_MIN_FREE_MB=512

# Set this if the dashboard runs in Docker inside an LXC or a VM with a memory
# cap. From in there /proc/meminfo reports the *outer host's* memory and the
# container's own cgroup says "max", so nothing visible knows the real ceiling
# — on a Proxmox LXC capped at 8 GB it read 63 GB, which would have waved
# machines through until the OOM killer started choosing victims. Give the
# fleet's real budget in MB and the guard does deterministic arithmetic
# instead. 0 means auto-detect.
DESKSWARM_MEMORY_BUDGET_MB=0

# ---------------------------------------------------------------------------
# Working in a machine
# ---------------------------------------------------------------------------

# Give each machine a named Docker volume for /home/cua so a restart, or a
# rebuild onto a newer image, doesn't throw away what you were doing. Note
# that snapshots capture installed software, not the home volume — that split
# is deliberate: a snapshot is a software baseline, home is your data.
DESKSWARM_PERSIST_HOME=1

# Largest single file the dashboard will push into a machine.
DESKSWARM_MAX_UPLOAD_MB=64

# Refuse to create machines or snapshots below this, and warn below the second.
DESKSWARM_MIN_FREE_DISK_GB=5
DESKSWARM_LOW_DISK_WARN_GB=15

# Pause dispatch after this many failures in a row — usually the model
# provider is unreachable and every further task just spends money. It lets
# one through again after the cooldown. 0 disables it.
DESKSWARM_FAILURE_BREAKER=5
DESKSWARM_BREAKER_COOLDOWN_MIN=10

# ---------------------------------------------------------------------------
# Fleet runtime
# ---------------------------------------------------------------------------

# Hostname/IP the *browser* uses to reach this host's published noVNC ports.
# Use the machine's LAN IP if you open the dashboard from another device.
DESKSWARM_PUBLIC_HOST=localhost

# First host port used for a computer's noVNC screen; each new computer
# takes the next free port upward.
DESKSWARM_NOVNC_PORT_BASE=6901

# Docker network the desktop/bridge containers join. Must be the network the
# dashboard container is on — the compose default is <project>_default.
DESKSWARM_NETWORK=deskswarm_default

# Set to 1 only on hosts that can't apply AppArmor profiles to containers
# (e.g. Docker nested inside a Proxmox LXC). Leave empty on normal hosts.
DESKSWARM_DISABLE_APPARMOR=

# ---------------------------------------------------------------------------
# Per-machine limits
# ---------------------------------------------------------------------------

# What one machine may take. Without a cap, a single runaway browser tab or a
# `while true` in someone's terminal starves every other machine and the
# dashboard with it — and the symptom is "the whole fleet froze", which is
# painful to trace back to one desktop.
#
# 2g suits a desktop with a browser and an office suite; drop to 1g for
# light machines, raise for builds. Set any of these to 0 (or empty, for the
# memory ones) to leave that dimension unbounded.
#
# If the host can't apply cgroup limits — some nested-Docker and unprivileged
# LXC setups — the dashboard notices on the first machine it starts, logs it,
# and carries on without them rather than refusing to start anything.
DESKSWARM_MACHINE_MEM_LIMIT=2g
DESKSWARM_MACHINE_CPUS=2
DESKSWARM_MACHINE_PIDS=512
DESKSWARM_BRIDGE_MEM_LIMIT=512m

# ---------------------------------------------------------------------------
# Idle suspend
# ---------------------------------------------------------------------------

# Stop machines nobody is watching, freeing all of their memory and CPU. A
# machine counts as in use while a browser has its screen open or a task is
# running on it; the timer only starts once neither is true.
#
# 0 = never, which is the default on purpose: sleeping ends the machine's X
# session, so open windows and unsaved work are lost. Saved files are not —
# they live on the home volume. Turn it on and machines you aren't using stop
# costing you RAM, which is usually what limits how many you can run:
# 30 is a reasonable starting point.
#
# Waking is automatic — clicking a sleeping machine's picture, or dispatching
# a task to it, starts it first. Individual machines can opt out from the
# wall ("no_suspend"), which is what you want for anything long-running.
DESKSWARM_IDLE_SUSPEND_MINUTES=0

# How long to wait for a woken machine's bridge to answer before handing back
# a "started, not ready yet".
DESKSWARM_WAKE_TIMEOUT=45

# Ceiling on one clipboard transfer.
DESKSWARM_MAX_CLIPBOARD_KB=256

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# A backup is one machine's whole home directory, gzipped, written to the
# dashboard's data volume. It is not a snapshot: a snapshot captures installed
# software (the image), a backup captures your files (the volume). You want
# both, for different reasons.
#
# Restoring REPLACES the home directory and stops the machine while it does,
# so open windows are lost. An uploaded archive is treated as untrusted:
# members that climb out of the home directory are dropped, not unpacked.
DESKSWARM_BACKUP_DIR=/app/data/backups

# How many to keep per machine. Backups are the likeliest thing to fill a disk
# quietly, and a full disk breaks Docker in confusing ways.
DESKSWARM_BACKUP_KEEP=5

# 'HH:MM' UTC to back up every machine daily. Empty means no schedule.
# Sleeping machines are included without being woken.
DESKSWARM_BACKUP_DAILY_AT=

# ---------------------------------------------------------------------------
# Share links
# ---------------------------------------------------------------------------

# A share is a link to exactly one machine, with an expiry and a revoke — as
# opposed to handing someone the dashboard, which is every machine plus a root
# shell on each.
#
#   watch    the screen is served through the link itself. Revoking is
#            complete and immediate; the machine's VNC password is never
#            exposed.
#   control  the page embeds the machine's own noVNC, so the guest gets
#            keyboard and mouse — and their browser is handed that machine's
#            screen password. Revoking closes the page but cannot retract a
#            URL they already saved. Rotating the machine's password does,
#            and the dashboard offers that next to the revoke.
DESKSWARM_SHARE_DEFAULT_HOURS=24
DESKSWARM_SHARE_MAX_HOURS=720

# ---------------------------------------------------------------------------
# Audit log
# ---------------------------------------------------------------------------

# Every state-changing request is recorded with who, what, which machine and
# the result — including each time a guest opens a share. Contents are not:
# the shell command is kept because that is the point of the log, but
# clipboard text and file bodies are only ever counted.
#
# 0 keeps everything for ever, which eventually becomes the reason the disk
# filled.
DESKSWARM_AUDIT_RETENTION_DAYS=90
