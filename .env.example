# ---------------------------------------------------------------------------
# deskswarm configuration
# Copy this file to .env and fill in the values before `docker compose up`.
# ---------------------------------------------------------------------------

# VNC password shared by every desktop container in the fleet.
VNC_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Model configuration
#
# deskswarm uses the cua Agent SDK (https://github.com/trycua/cua), which is
# built on LiteLLM — so DESKSWARM_MODEL accepts any LiteLLM model string.
# Pick ONE of the setups below.
# ---------------------------------------------------------------------------

# --- Option A: Anthropic API directly (recommended, most reliable) ---------
# Get a key at https://console.anthropic.com — this is a real billed API
# key, NOT a claude.ai / Claude Pro subscription login.
# DESKSWARM_MODEL=anthropic/claude-haiku-4-5-20251001
# DESKSWARM_API_KEY=sk-ant-...
# DESKSWARM_API_BASE=

# --- Option B: OpenAI API directly ------------------------------------------
# DESKSWARM_MODEL=openai/gpt-4o
# DESKSWARM_API_KEY=sk-...
# DESKSWARM_API_BASE=

# --- Option C: any OpenAI-compatible proxy ----------------------------------
# Works with LiteLLM proxy, an internal gateway, or similar — anything that
# speaks the OpenAI /v1/chat/completions shape. Use a model name containing
# "claude-" to route through cua's Anthropic-style tool loop, which is the
# best-tested path.
# DESKSWARM_MODEL=anthropic/claude-sonnet-4-6
# DESKSWARM_API_BASE=http://your-proxy-host:port
# DESKSWARM_API_KEY=your-proxy-api-key

# --- Option D: local Ollama ---------------------------------------------------
# Experimental — see README "Local models" section. Needs extra deps
# (torch, qwen-agent) baked into a custom dashboard image; not included by
# default because of image size. Vision-capable models with tool-calling
# support work best (e.g. qwen3.5).
# DESKSWARM_MODEL=ollama_chat/qwen3.5:9b
# DESKSWARM_API_BASE=http://your-ollama-host:11434
# DESKSWARM_API_KEY=

DESKSWARM_MODEL=anthropic/claude-haiku-4-5-20251001
DESKSWARM_API_KEY=
DESKSWARM_API_BASE=

# ---------------------------------------------------------------------------
# Dashboard auth (optional but recommended)
#
# If set, POST /api/v1/tasks requires "Authorization: Bearer <token>".
# Leave empty for local/trusted-network use only.
# ---------------------------------------------------------------------------
DASHBOARD_TOKEN=

# ---------------------------------------------------------------------------
# Fleet topology
#
# One entry per desktop+bridge pair defined in docker-compose.yml.
# bridge_host must match the bridge service name on the docker network.
# novnc_url is what "watch live" links to in the dashboard (host-published
# port, so it must match the *_NOVNC_PORT ports below).
# ---------------------------------------------------------------------------
FLEET_JSON=[{"name":"desktop-1","bridge_host":"bridge-1","bridge_port":8000,"novnc_url":"http://localhost:6901/vnc.html"},{"name":"desktop-2","bridge_host":"bridge-2","bridge_port":8000,"novnc_url":"http://localhost:6902/vnc.html"},{"name":"desktop-3","bridge_host":"bridge-3","bridge_port":8000,"novnc_url":"http://localhost:6903/vnc.html"}]

DESKTOP_1_NOVNC_PORT=6901
DESKTOP_2_NOVNC_PORT=6902
DESKTOP_3_NOVNC_PORT=6903
DASHBOARD_PORT=7861
